{
  "name": "sound-toy",
  "version": "1.0.0",
  "description": "An audio-reactive particle instrument: tempo tracking, kick detection and MIDI control driving a particle globe and its moon.",
  "author": "Lenny Ford <https://len.studio>",
  "license": "MIT",
  "homepage": "https://len.studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
